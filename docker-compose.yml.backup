services:

  # 1. PostgreSQL 16 + pgvector Store


  # 2. ASP.NET Core 8 Web API
  backend:
    image: clausio-backend:latest
    container_name: clausio-backend-api
    restart: always
    ports:
      - "127.0.0.1:5123:5123"
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_URLS: http://+:5123
      ConnectionStrings__Default: Host=database-1.cd2o4g4yqiiy.ap-south-1.rds.amazonaws.com;Port=5432;Database=clausio_db;Username=postgres;Password=${RDS_PASSWORD}
      AWS__Region: ap-south-1
      AWS__S3BucketName: clausio-files-prod
      AWS__SQSQueueUrl: ${AWS_SQS_QUEUE_URL}
      Jwt__Secret: ${JWT_SECRET}
      Jwt__Issuer: Clausio
      Jwt__Audience: ClausioClients
      AI__Groq__ApiKey: ${GROQ_API_KEY}
      AI__DeepProvider__ApiKey: ${GROQ_API_KEY}
      AI__DeepProvider__BaseUrl: https://api.groq.com/openai/v1
      AI__DeepProvider__ModelId: llama-3.3-70b-versatile
      AI__FastProvider__ApiKey: ${GROQ_API_KEY}
      AI__FastProvider__BaseUrl: https://api.groq.com/openai/v1
      AI__FastProvider__ModelId: llama-3.3-70b-versatile
      AI__EmbeddingProvider__ApiKey: ${OPENROUTER_API_KEY}
      AI__EmbeddingProvider__BaseUrl: https://openrouter.ai/api/v1
      AI__EmbeddingProvider__ModelId: nvidia/nemotron-3-embed-1b:free
      Resend__ApiKey: ${RESEND_API_KEY}
      Resend__FromEmail: ${RESEND_FROM_EMAIL}
      Resend__FromName: ${RESEND_FROM_NAME}
      AWS__AccessKeyId: AKIAWRKIVAKODONT7PVF
      AWS__SecretAccessKey: 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
      Google__ClientId: 563496014866-c6uo81ohlca4luucjngq4j45b5nndh0r.apps.googleusercontent.com
      Google__ClientSecret: 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
      Google__RedirectUri: https://app.clausiotech.com/api/integrations/google/callback
      GoogleCalendar__RedirectUri: https://app.clausiotech.com/api/integrations/google/callback
      GoogleDrive__ApiKey: AIzaSyAYoJHCNTHPr-D1nwjOrX_SSolXr3mh2NM
  # 3. Next.js 14 Web Frontend
  frontend:
    image: clausio-frontend:latest
    container_name: clausio-frontend-web
    restart: always
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      NODE_ENV: production
      NEXT_PUBLIC_API_URL: /api
    depends_on:
      - backend

  # 4. Python Speech-to-Text Microservice
  voice-backend:
    image: 449513325212.dkr.ecr.ap-south-1.amazonaws.com/clausio-voice-backend:latest
    container_name: clausio-voice-microservice
    restart: always
    ports:
      - "127.0.0.1:8000:8000"

